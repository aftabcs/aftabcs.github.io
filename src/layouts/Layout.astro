---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = "Aftab Alam — Software Developer", description = "Senior Mobile & Full-Stack Engineer specializing in Flutter and fintech." } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      // Theme init — runs before render to avoid FOUC
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text-primary)] font-body antialiased">
    <!-- Full-page tech grid overlay -->
    <div class="fixed inset-0 pointer-events-none tech-grid opacity-60 z-0"></div>

    <!-- Full-page animated gradient orbs -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <!-- Primary red orb — top center -->
      <div class="absolute rounded-full" style="
        width: 700px; height: 700px;
        top: -200px; left: 30%;
        background: radial-gradient(circle, rgba(225,29,72,0.22) 0%, rgba(190,18,60,0.10) 50%, transparent 70%);
        filter: blur(60px);
        animation: orbDriftA 18s ease-in-out infinite;
      "></div>
      <!-- Cyan complement orb — right side -->
      <div class="absolute rounded-full" style="
        width: 500px; height: 500px;
        top: 40%; right: -100px;
        background: radial-gradient(circle, rgba(6,182,212,0.18) 0%, rgba(6,182,212,0.06) 50%, transparent 70%);
        filter: blur(50px);
        animation: orbDriftB 22s ease-in-out infinite;
      "></div>
      <!-- Deep red orb — bottom left -->
      <div class="absolute rounded-full" style="
        width: 400px; height: 400px;
        bottom: -100px; left: -80px;
        background: radial-gradient(circle, rgba(190,18,60,0.15) 0%, rgba(225,29,72,0.05) 50%, transparent 70%);
        filter: blur(40px);
        animation: orbDriftC 26s ease-in-out infinite;
      "></div>
      <!-- Accent orb — top right -->
      <div class="absolute rounded-full" style="
        width: 300px; height: 300px;
        top: 10%; right: 10%;
        background: radial-gradient(circle, rgba(225,29,72,0.10) 0%, transparent 70%);
        filter: blur(30px);
        animation: orbDriftB 30s ease-in-out infinite reverse;
      "></div>
      <!-- Mid-page red orb — adds depth behind middle sections -->
      <div class="absolute rounded-full" style="
        width: 600px; height: 600px;
        top: 60%; left: 10%;
        background: radial-gradient(circle, rgba(225,29,72,0.14) 0%, rgba(190,18,60,0.06) 50%, transparent 70%);
        filter: blur(55px);
        animation: orbDriftA 24s ease-in-out infinite reverse;
      "></div>
      <!-- Bottom cyan orb — adds variety near footer -->
      <div class="absolute rounded-full" style="
        width: 450px; height: 450px;
        bottom: 15%; right: 5%;
        background: radial-gradient(circle, rgba(6,182,212,0.12) 0%, rgba(6,182,212,0.04) 50%, transparent 70%);
        filter: blur(45px);
        animation: orbDriftC 20s ease-in-out infinite;
      "></div>
    </div>

    <div class="relative z-10">
      <slot />
    </div>
    <script is:inline>
      // Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            // Stagger children
            const children = entry.target.querySelectorAll('.stagger-child');
            children.forEach((child, i) => {
              child.style.transitionDelay = `${i * 80}ms`;
              child.classList.add('revealed');
            });
          }
        });
      }, { threshold: 0.15 });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      // Nav scroll behavior
      const nav = document.querySelector('nav');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
          nav?.classList.add('scrolled');
        } else {
          nav?.classList.remove('scrolled');
        }
      });

      // Active nav link via IntersectionObserver
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('nav a[href^="#"]');
      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navLinks.forEach(link => {
              link.classList.remove('active-nav');
              if (link.getAttribute('href') === `#${entry.target.id}`) {
                link.classList.add('active-nav');
              }
            });
          }
        });
      }, { threshold: 0.5 });

      sections.forEach(s => sectionObserver.observe(s));
    </script>
  </body>
</html>
