---
---
<section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden">
  <!-- Multi-layer radial gradient background -->
  <div class="absolute inset-0 pointer-events-none" style="
    background:
      radial-gradient(ellipse 60% 50% at 50% -10%, rgba(139,92,246,0.18), transparent 70%),
      radial-gradient(ellipse 40% 40% at 90% 90%, rgba(109,40,217,0.08), transparent 60%),
      radial-gradient(ellipse 30% 50% at -5% 50%, rgba(139,92,246,0.05), transparent 60%)
  "></div>

  <div class="max-w-[1280px] mx-auto px-6 pt-32 pb-16 lg:pt-48 lg:pb-24 relative z-10">
    <!-- Status badge — glass pill -->
    <div id="hero-label" class="opacity-0 translate-y-4 transition-all duration-500 mb-6">
      <span class="inline-flex items-center font-mono text-[0.7rem] uppercase tracking-widest px-3 py-1.5 rounded-full" style="
        background: var(--glass-frosted);
        backdrop-filter: var(--blur-sm);
        -webkit-backdrop-filter: var(--blur-sm);
        border: 1px solid rgba(139,92,246,0.30);
        color: var(--color-accent-bright);
      ">
        FULL-STACK DEVELOPER &bull; OPEN TO WORK
      </span>
    </div>

    <!-- Name -->
    <h1 class="font-display font-black leading-none tracking-tighter mb-6">
      <span id="hero-name1" class="block opacity-0 translate-y-8 transition-all duration-700" style="font-size: clamp(4rem, 10vw, 9rem)">AFTAB</span>
      <span id="hero-name2" class="block opacity-0 translate-y-8 transition-all duration-700" style="font-size: clamp(4rem, 10vw, 9rem)">
        ALAM<span class="text-[var(--color-accent)]">.</span>
      </span>
    </h1>

    <!-- Tagline -->
    <p id="hero-tagline" class="opacity-0 transition-all duration-500 mb-10 max-w-lg" style="font-size: clamp(1.125rem, 2vw, 1.5rem); line-height: 1.6; color: var(--color-text-secondary)">
      Building fast, accessible products<br class="hidden sm:block" /> for the web and mobile.
    </p>

    <!-- CTAs -->
    <div id="hero-ctas" class="opacity-0 transition-all duration-500 flex flex-col sm:flex-row gap-3">
      <!-- Primary CTA -->
      <a
        href="#projects"
        class="inline-flex items-center justify-center gap-2 text-white font-body font-medium px-7 py-3.5 rounded-lg hover:brightness-110 hover:-translate-y-0.5 transition-all duration-200"
        style="
          background: var(--color-accent-gradient);
          border: 1px solid rgba(167,139,250,0.30);
          box-shadow: 0 4px 24px rgba(139,92,246,0.35), inset 0 1px 0 rgba(255,255,255,0.15);
        "
      >
        View My Work
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <!-- Secondary CTA -->
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 font-body font-medium px-7 py-3.5 rounded-lg hover:-translate-y-0.5 transition-all duration-200"
        style="
          background: var(--glass-frosted);
          backdrop-filter: var(--blur-sm);
          -webkit-backdrop-filter: var(--blur-sm);
          border: 1px solid rgba(139,92,246,0.40);
          color: var(--color-accent-bright);
          box-shadow: var(--shadow-glass-sm);
        "
      >
        Let's Talk
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div id="scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 transition-opacity duration-300" style="color: var(--color-text-muted)">
    <span class="font-mono text-[0.65rem] uppercase tracking-widest">Scroll</span>
    <svg class="animate-bounce" width="20" height="20" viewBox="0 0 20 20" fill="none">
      <path d="M10 4v12M4 10l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<script is:inline>
  setTimeout(() => {
    document.getElementById('hero-label')?.classList.remove('opacity-0', 'translate-y-4');
  }, 100);
  setTimeout(() => {
    document.getElementById('hero-name1')?.classList.remove('opacity-0', 'translate-y-8');
  }, 280);
  setTimeout(() => {
    document.getElementById('hero-name2')?.classList.remove('opacity-0', 'translate-y-8');
  }, 460);
  setTimeout(() => {
    document.getElementById('hero-tagline')?.classList.remove('opacity-0');
  }, 640);
  setTimeout(() => {
    document.getElementById('hero-ctas')?.classList.remove('opacity-0');
  }, 800);

  window.addEventListener('scroll', () => {
    const indicator = document.getElementById('scroll-indicator');
    if (indicator) {
      indicator.style.opacity = window.scrollY > 100 ? '0' : '1';
    }
  });
</script>
