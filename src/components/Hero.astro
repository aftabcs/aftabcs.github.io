---
const codeSnippets = [
  { code: "flutter pub get",     top: "12%",  left: "72%", delay: "0s"   },
  { code: "git push origin main",top: "28%",  left: "78%", delay: "1.2s" },
  { code: "npm run build",       top: "58%",  left: "68%", delay: "2.4s" },
  { code: "cargo build --release",top: "75%", left: "75%", delay: "3.6s" },
  { code: "docker compose up",   top: "42%",  left: "80%", delay: "0.8s" },
];

const typewriterPhrases = [
  "Building fast, accessible products",
  "for the web and mobile.",
];
---
<section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden">

  <!-- Tech grid overlay -->
  <div class="absolute inset-0 pointer-events-none tech-grid opacity-60"></div>

  <!-- Animated gradient orbs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Primary purple orb -->
    <div class="absolute rounded-full" style="
      width: 700px; height: 700px;
      top: -200px; left: 30%;
      background: radial-gradient(circle, rgba(139,92,246,0.22) 0%, rgba(109,40,217,0.10) 50%, transparent 70%);
      filter: blur(60px);
      animation: orbDriftA 18s ease-in-out infinite;
    "></div>
    <!-- Cyan complement orb -->
    <div class="absolute rounded-full" style="
      width: 500px; height: 500px;
      top: 40%; right: -100px;
      background: radial-gradient(circle, rgba(6,182,212,0.18) 0%, rgba(6,182,212,0.06) 50%, transparent 70%);
      filter: blur(50px);
      animation: orbDriftB 22s ease-in-out infinite;
    "></div>
    <!-- Deep purple orb bottom-left -->
    <div class="absolute rounded-full" style="
      width: 400px; height: 400px;
      bottom: -100px; left: -80px;
      background: radial-gradient(circle, rgba(109,40,217,0.15) 0%, rgba(139,92,246,0.05) 50%, transparent 70%);
      filter: blur(40px);
      animation: orbDriftC 26s ease-in-out infinite;
    "></div>
    <!-- Subtle top-right accent -->
    <div class="absolute rounded-full" style="
      width: 300px; height: 300px;
      top: 10%; right: 10%;
      background: radial-gradient(circle, rgba(139,92,246,0.10) 0%, transparent 70%);
      filter: blur(30px);
      animation: orbDriftB 30s ease-in-out infinite reverse;
    "></div>
  </div>

  <!-- Floating code snippets (desktop only) -->
  <div class="absolute inset-0 pointer-events-none hidden lg:block">
    {codeSnippets.map((s) => (
      <div
        class="absolute font-mono text-[0.65rem] px-2.5 py-1.5 rounded-md"
        style={`
          top: ${s.top}; left: ${s.left};
          background: rgba(10,10,16,0.70);
          backdrop-filter: blur(8px);
          border: 1px solid rgba(139,92,246,0.20);
          color: rgba(167,139,250,0.55);
          white-space: nowrap;
          animation: orbDriftC ${parseFloat(s.delay) * 4 + 20}s ease-in-out infinite;
          animation-delay: ${s.delay};
          opacity: 0.65;
        `}
      >
        <span style="color: rgba(6,182,212,0.60)">$</span> {s.code}
      </div>
    ))}
  </div>

  <div class="max-w-[1280px] mx-auto px-6 pt-32 pb-16 lg:pt-48 lg:pb-24 relative z-10">

    <!-- Status badge — pulsing glass pill -->
    <div id="hero-label" class="opacity-0 translate-y-4 transition-all duration-500 mb-6">
      <span id="status-badge" class="badge-pulse inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-widest px-3 py-1.5 rounded-full" style="
        background: var(--glass-frosted);
        backdrop-filter: var(--blur-sm);
        -webkit-backdrop-filter: var(--blur-sm);
        border: 1px solid rgba(139,92,246,0.45);
        color: var(--color-accent-bright);
      ">
        <span class="inline-block w-1.5 h-1.5 rounded-full" style="background: #4ADE80; box-shadow: 0 0 6px #4ADE80;"></span>
        FULL-STACK DEVELOPER &bull; OPEN TO WORK
      </span>
    </div>

    <!-- Name — gradient text -->
    <h1 class="font-display font-black leading-none tracking-tighter mb-6">
      <span id="hero-name1" class="block opacity-0 translate-y-8 transition-all duration-700 text-gradient" style="font-size: clamp(4rem, 10vw, 9rem)">AFTAB</span>
      <span id="hero-name2" class="block opacity-0 translate-y-8 transition-all duration-700" style="font-size: clamp(4rem, 10vw, 9rem); color: var(--color-text-primary)">
        ALAM<span class="text-gradient">.</span>
      </span>
    </h1>

    <!-- Tagline — typing effect -->
    <div id="hero-tagline" class="opacity-0 transition-all duration-500 mb-10 max-w-lg" style="font-size: clamp(1.125rem, 2vw, 1.5rem); line-height: 1.6; color: var(--color-text-secondary)">
      <span id="typewriter-text"></span><span class="cursor-blink" style="color: var(--color-accent)">|</span>
    </div>

    <!-- CTAs -->
    <div id="hero-ctas" class="opacity-0 transition-all duration-500 flex flex-col sm:flex-row gap-3">
      <!-- Primary CTA -->
      <a
        href="#projects"
        class="inline-flex items-center justify-center gap-2 text-white font-body font-medium px-7 py-3.5 rounded-lg hover:brightness-115 hover:-translate-y-1 transition-all duration-200"
        style="
          background: var(--color-accent-gradient);
          border: 1px solid rgba(167,139,250,0.40);
          box-shadow: 0 4px 24px rgba(139,92,246,0.45), 0 0 48px rgba(139,92,246,0.20), inset 0 1px 0 rgba(255,255,255,0.20);
        "
      >
        View My Work
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <!-- Secondary CTA -->
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 font-body font-medium px-7 py-3.5 rounded-lg hover:-translate-y-1 transition-all duration-200"
        style="
          background: var(--glass-frosted);
          backdrop-filter: var(--blur-sm);
          -webkit-backdrop-filter: var(--blur-sm);
          border: 1px solid rgba(139,92,246,0.50);
          color: var(--color-accent-bright);
          box-shadow: var(--shadow-glass-sm), 0 0 20px rgba(139,92,246,0.15);
        "
      >
        Let's Talk
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div id="scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 transition-opacity duration-300" style="color: var(--color-text-muted)">
    <span class="font-mono text-[0.65rem] uppercase tracking-widest">Scroll</span>
    <svg class="animate-bounce" width="20" height="20" viewBox="0 0 20 20" fill="none">
      <path d="M10 4v12M4 10l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<script is:inline>
  // Staggered reveal
  setTimeout(() => {
    document.getElementById('hero-label')?.classList.remove('opacity-0', 'translate-y-4');
  }, 100);
  setTimeout(() => {
    document.getElementById('hero-name1')?.classList.remove('opacity-0', 'translate-y-8');
  }, 280);
  setTimeout(() => {
    document.getElementById('hero-name2')?.classList.remove('opacity-0', 'translate-y-8');
  }, 460);
  setTimeout(() => {
    document.getElementById('hero-tagline')?.classList.remove('opacity-0');
    // Typing effect
    const phrases = [
      "Building fast, accessible products",
      "\nfor the web and mobile."
    ];
    const fullText = "Building fast, accessible products\nfor the web and mobile.";
    const el = document.getElementById('typewriter-text');
    if (!el) return;
    let i = 0;
    function type() {
      if (i <= fullText.length) {
        el.innerHTML = fullText.slice(0, i).replace('\n', '<br>');
        i++;
        setTimeout(type, i === 1 ? 60 : 38 + Math.random() * 20);
      }
    }
    type();
  }, 640);
  setTimeout(() => {
    document.getElementById('hero-ctas')?.classList.remove('opacity-0');
  }, 800);

  window.addEventListener('scroll', () => {
    const indicator = document.getElementById('scroll-indicator');
    if (indicator) {
      indicator.style.opacity = window.scrollY > 100 ? '0' : '1';
    }
  });
</script>
