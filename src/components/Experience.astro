---
const experiences = [
  {
    role: "Software Engineer — Mobile Development Lead",
    company: "Codebase Technology",
    location: "Bahrain",
    period: "Apr 2025 – Present",
    current: true,
    bullets: [
      "Leading mobile development for Ajman Bank Connect, Capital Bank, and Neo Bank Audi",
      "Architecting Flutter apps with Clean Architecture + Riverpod state management",
      "Driving cross-functional collaboration across design, backend, and QA teams",
    ],
  },
  {
    role: "Software Developer",
    company: "NeoSoft Technology",
    location: "India",
    period: "Jun 2022 – Mar 2025",
    bullets: [
      "Built production Flutter apps across fintech and sustainability domains",
      "Developed ICICI Virtual RM and MyTree carbon footprint tracker",
      "Implemented complex UI patterns, offline-first storage, and payment integrations",
    ],
  },
  {
    role: "Freelance Developer",
    company: "Self-Employed",
    location: "Remote",
    period: "2021 – 2022",
    bullets: [
      "Delivered Afeefa Handlooms mobile CRM — full-stack Flutter + Firestore",
      "End-to-end client management: requirements, development, deployment",
    ],
  },
  {
    role: "Programming Instructor",
    company: "The Pro Institute",
    location: "India",
    period: "2020 (6 months)",
    bullets: [
      "Taught programming fundamentals and app development to students",
      "Created curriculum for introductory mobile development course",
    ],
  },
];
---
<section id="experience" class="py-24 lg:py-32">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="reveal mb-16">
      <div class="section-label mb-4">Experience</div>
      <h2 class="font-display font-bold" style="font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: -0.03em; line-height: 1.05; color: var(--color-text-primary)">
        Career Timeline
      </h2>
    </div>

    <!-- Desktop timeline -->
    <div class="hidden lg:block relative">
      <!-- Gradient vertical line -->
      <div class="absolute left-[168px] top-0 bottom-0 w-px" style="
        background: linear-gradient(
          to bottom,
          transparent,
          var(--color-accent-glow) 20%,
          var(--color-accent-glow) 80%,
          transparent
        )
      "></div>

      <div class="space-y-12">
        {experiences.map((exp, i) => (
          <div class="flex gap-0 reveal" style={`transition-delay: ${i * 100}ms`}>
            <!-- Date column -->
            <div class="w-40 shrink-0 text-right pr-8 pt-0.5">
              <span class="font-mono text-[0.8rem]" style="color: var(--color-text-muted)">{exp.period}</span>
            </div>

            <!-- Dot -->
            <div class="relative flex items-start justify-center w-8 shrink-0 pt-1">
              <div
                class:list={["rounded-full", exp.current ? "w-3.5 h-3.5 dot-pulse" : "w-2.5 h-2.5"]}
                style={exp.current
                  ? `background: var(--color-accent); box-shadow: 0 0 0 3px rgba(139,92,246,0.25), 0 0 16px rgba(139,92,246,0.60)`
                  : `background: var(--color-accent); opacity: 0.8; box-shadow: 0 0 8px rgba(139,92,246,0.35)`
                }
              ></div>
            </div>

            <!-- Content — glass card -->
            <div class="flex-1 pl-6 pb-4">
              <div class="exp-card rounded-[var(--radius-lg)] p-5 transition-all duration-300" style="
                background: var(--glass-raised);
                backdrop-filter: var(--blur-md);
                -webkit-backdrop-filter: var(--blur-md);
                border: 1px solid var(--color-border);
                border-top-color: var(--color-border-light);
                box-shadow: var(--shadow-glass-base);
              ">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="font-display font-semibold text-lg" style="color: var(--color-text-primary)">{exp.role}</h3>
                  <span style="color: var(--color-text-muted)">·</span>
                  <span class="font-body font-medium text-sm" style="color: var(--color-accent-bright)">{exp.company}</span>
                  <span class="font-mono text-[0.7rem]" style="color: var(--color-text-muted)">{exp.location}</span>
                </div>
                <ul class="space-y-1.5 mt-3">
                  {exp.bullets.map(bullet => (
                    <li class="flex gap-2 text-sm leading-relaxed" style="color: var(--color-text-secondary)">
                      <span class="mt-1 shrink-0" style="color: var(--color-accent)">–</span>
                      {bullet}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: glass cards -->
    <div class="lg:hidden space-y-4">
      {experiences.map((exp, i) => (
        <div class="rounded-2xl p-5 reveal" style={`
          background: var(--glass-raised);
          backdrop-filter: var(--blur-md);
          -webkit-backdrop-filter: var(--blur-md);
          border: 1px solid var(--color-border);
          border-top-color: var(--color-border-light);
          box-shadow: var(--shadow-glass-base);
          transition-delay: ${i * 80}ms;
        `}>
          <div class="font-mono text-[0.75rem] mb-2" style="color: var(--color-accent-bright)">{exp.period}</div>
          <h3 class="font-display font-semibold text-base mb-0.5" style="color: var(--color-text-primary)">{exp.role}</h3>
          <div class="text-sm mb-3" style="color: var(--color-text-muted)">{exp.company} · {exp.location}</div>
          <ul class="space-y-1.5">
            {exp.bullets.map(bullet => (
              <li class="flex gap-2 text-sm leading-relaxed" style="color: var(--color-text-secondary)">
                <span class="shrink-0" style="color: var(--color-accent)">–</span>
                {bullet}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-card:hover {
    border-color: rgba(139,92,246,0.35) !important;
    box-shadow: var(--shadow-glass-lg), 0 0 24px rgba(139,92,246,0.18) !important;
    transform: translateY(-2px);
  }
</style>
