---
const skillCategories = [
  {
    name: "Languages",
    skills: ["Dart", "TypeScript", "Python", "HTML", "CSS"],
  },
  {
    name: "Mobile",
    skills: ["Flutter", "Cross-platform", "iOS", "Android"],
  },
  {
    name: "Web",
    skills: ["Angular", "NestJS", "Node.js"],
  },
  {
    name: "Backend / DB",
    skills: ["Firebase", "Firestore", "Appwrite", "SQLite", "Hive"],
  },
  {
    name: "Architecture",
    skills: ["Clean Architecture", "MVVM", "MVC", "Dio", "Riverpod"],
  },
  {
    name: "APIs / SDKs",
    skills: ["Facebook API", "Google API", "Infobip", "Microblink", "UAE Pass"],
  },
];

const skillIcon: Record<string, string> = {
  "Dart": "Da", "TypeScript": "TS", "Python": "Py", "HTML": "HT", "CSS": "CS",
  "Flutter": "Fl", "Cross-platform": "Cx", "iOS": "iOS", "Android": "An",
  "Angular": "Ng", "NestJS": "Ns", "Node.js": "No",
  "Firebase": "Fb", "Firestore": "Fs", "Appwrite": "Aw", "SQLite": "SQ", "Hive": "Hi",
  "Clean Architecture": "CA", "MVVM": "MV", "MVC": "MC", "Dio": "Di", "Riverpod": "Rv",
  "Facebook API": "FB", "Google API": "Go", "Infobip": "Ib", "Microblink": "Mb", "UAE Pass": "UP",
};
---
<section id="skills" class="py-24 lg:py-32">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="reveal mb-12">
      <div class="section-label mb-4">Skills</div>
      <h2 class="font-display font-bold" style="font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: -0.03em; line-height: 1.05; color: var(--color-text-primary)">
        Technical Stack
      </h2>
    </div>

    <!-- Glass container -->
    <div class="rounded-[var(--radius-2xl)] p-8 lg:p-10" style="
      background: var(--glass-base);
      backdrop-filter: var(--blur-md);
      -webkit-backdrop-filter: var(--blur-md);
      border: 1px solid var(--color-border);
      border-top-color: var(--color-border-light);
      box-shadow: var(--shadow-glass-base);
    ">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {skillCategories.map((cat, ci) => (
          <div class="reveal" style={`transition-delay: ${ci * 80}ms`}>
            <!-- Category header -->
            <div class="font-display font-bold text-base mb-4 pb-2" style={`color: var(--color-text-primary); border-bottom: 1px solid var(--color-border)`}>{cat.name}</div>
            <div class="flex flex-wrap gap-2">
              {cat.skills.map((skill, si) => (
                <div
                  class="skill-chip group relative flex flex-col items-center justify-center w-14 h-14 md:w-16 md:h-16 cursor-default transition-all duration-200 stagger-child"
                  style={`
                    background: #0C0C10;
                    border: 1px solid var(--color-border);
                    border-radius: var(--radius-md);
                    box-shadow: var(--shadow-neo-inset);
                    transition-delay: ${si * 40}ms;
                    transition-timing-function: cubic-bezier(0.34,1.56,0.64,1);
                  `}
                  data-skill={skill}
                >
                  <span class="font-mono font-medium text-[0.65rem] leading-none transition-colors duration-200" style="color: var(--color-text-secondary)">
                    {skillIcon[skill] || skill.slice(0, 2)}
                  </span>
                  <!-- Tooltip -->
                  <div class="skill-tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded-lg font-mono text-xs whitespace-nowrap opacity-0 pointer-events-none -translate-y-1 transition-all duration-150 z-10" style="
                    background: var(--glass-raised);
                    backdrop-filter: var(--blur-sm);
                    border: 1px solid var(--color-border);
                    color: var(--color-text-primary);
                  ">
                    {skill}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skill-chip:hover {
    border-color: rgba(139,92,246,0.40) !important;
    box-shadow: var(--shadow-neo-inset), 0 0 12px rgba(139,92,246,0.15) !important;
  }
  .skill-chip:hover span {
    color: var(--color-accent-bright) !important;
  }
  .skill-chip:hover .skill-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
