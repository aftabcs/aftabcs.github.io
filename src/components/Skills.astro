---
const skillCategories = [
  {
    name: "Languages",
    skills: ["Dart", "TypeScript", "Python", "HTML", "CSS"],
  },
  {
    name: "Mobile",
    skills: ["Flutter", "Cross-platform", "iOS", "Android"],
  },
  {
    name: "Web",
    skills: ["Angular", "NestJS", "Node.js"],
  },
  {
    name: "Backend / DB",
    skills: ["Firebase", "Firestore", "Appwrite", "SQLite", "Hive"],
  },
  {
    name: "Architecture",
    skills: ["Clean Architecture", "MVVM", "MVC", "Dio", "Riverpod"],
  },
  {
    name: "APIs / SDKs",
    skills: ["Facebook API", "Google API", "Infobip", "Microblink", "UAE Pass"],
  },
];

// Simple icon letters/emoji for visual interest
const skillIcon: Record<string, string> = {
  "Dart": "Da", "TypeScript": "TS", "Python": "Py", "HTML": "HT", "CSS": "CS",
  "Flutter": "Fl", "Cross-platform": "Cx", "iOS": "iOS", "Android": "An",
  "Angular": "Ng", "NestJS": "Ns", "Node.js": "No",
  "Firebase": "Fb", "Firestore": "Fs", "Appwrite": "Aw", "SQLite": "SQ", "Hive": "Hi",
  "Clean Architecture": "CA", "MVVM": "MV", "MVC": "MC", "Dio": "Di", "Riverpod": "Rv",
  "Facebook API": "FB", "Google API": "Go", "Infobip": "Ib", "Microblink": "Mb", "UAE Pass": "UP",
};
---
<section id="skills" class="py-24 lg:py-32 bg-[var(--color-surface)] bg-opacity-30">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="reveal mb-12">
      <div class="section-label mb-4">Skills</div>
      <h2 class="font-display font-bold text-[var(--color-text-primary)]" style="font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: -0.03em; line-height: 1.05">
        Technical Stack
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {skillCategories.map((cat, ci) => (
        <div class="reveal" style={`transition-delay: ${ci * 80}ms`}>
          <div class="font-mono text-[0.7rem] text-[var(--color-text-muted)] uppercase tracking-widest mb-4">{cat.name}</div>
          <div class="flex flex-wrap gap-3">
            {cat.skills.map((skill, si) => (
              <div
                class="skill-tile group relative flex flex-col items-center justify-center w-14 h-14 md:w-16 md:h-16 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl cursor-default transition-all duration-200 stagger-child"
                style={`transition-timing-function: cubic-bezier(0.34,1.56,0.64,1); transition-delay: ${si * 40}ms`}
                data-skill={skill}
              >
                <span class="font-mono font-medium text-[0.65rem] text-[var(--color-text-secondary)] group-hover:text-[var(--color-accent)] transition-colors leading-none">
                  {skillIcon[skill] || skill.slice(0, 2)}
                </span>
                <!-- Tooltip -->
                <div class="skill-tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-[var(--color-surface-raised)] border border-[var(--color-border)] rounded-lg font-mono text-xs text-[var(--color-text-primary)] whitespace-nowrap opacity-0 pointer-events-none -translate-y-1 transition-all duration-150 z-10">
                  {skill}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-tile:hover {
    transform: scale(1.08);
    border-color: var(--color-accent);
    background-color: var(--color-accent-subtle);
  }
  .skill-tile:hover .skill-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
