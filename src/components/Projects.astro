---
const projects = [
  {
    title: "Ajman Bank Connect",
    description: "Award-winning Islamic Digital Banking app. Full-featured mobile banking platform with investments, transfers, and Sharia-compliant products.",
    tech: ["Flutter", "Riverpod", "RxDart"],
    role: "Team Lead",
    featured: true,
    highlight: "Islamic Digital Banking Provider of the Year 2023",
  },
  {
    title: "Neo Bank Audi",
    description: "Production-grade digital banking with seamless onboarding, real-time transactions, and biometric auth.",
    tech: ["Flutter", "Riverpod", "Dio", "Firebase"],
    role: "Developer",
  },
  {
    title: "Capital Bank of Jordan",
    description: "Cross-platform mobile banking app serving customers across Jordan with full account management features.",
    tech: ["Flutter", "Riverpod", "RxDart"],
    role: "Developer",
  },
  {
    title: "ICICI Virtual RM",
    description: "Virtual Relationship Manager for mobile + web — AI-powered banking assistant for ICICI customers.",
    tech: ["Flutter", "Node.js", "Google Cloud"],
    role: "Flutter Dev",
  },
  {
    title: "MyTree",
    description: "Carbon footprint calculator with offset banking — helping users understand and reduce environmental impact.",
    tech: ["Flutter", "Firebase", "Google Analytics"],
    role: "Flutter Dev",
  },
  {
    title: "Afeefa Handlooms",
    description: "Mobile CRM for inventory management and client relationship tracking for a handloom business.",
    tech: ["Flutter", "Firestore"],
    role: "Flutter Dev",
  },
];
---
<section id="projects" class="py-24 lg:py-32">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="reveal mb-12">
      <div class="section-label mb-4">Projects</div>
      <h2 class="font-display font-bold text-[var(--color-text-primary)]" style="font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: -0.03em; line-height: 1.05">
        Selected Work
      </h2>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 auto-rows-auto">
      {projects.map((project, i) => (
        <div
          class:list={[
            "project-card group relative bg-[var(--color-surface)] border border-[var(--color-border)] overflow-hidden transition-all duration-250 cursor-default stagger-child reveal",
            project.featured ? "lg:col-span-2 lg:row-span-2 rounded-3xl" : "rounded-2xl"
          ]}
          style={`transition-timing-function: cubic-bezier(0.16,1,0.3,1); transition-delay: ${i * 60}ms`}
        >
          <!-- Placeholder image -->
          <div
            class:list={[
              "w-full bg-gradient-to-br from-[var(--color-surface-raised)] to-[var(--color-bg)] flex items-center justify-center overflow-hidden transition-transform duration-400",
              project.featured ? "h-56 lg:h-72" : "h-40"
            ]}
          >
            <div class="text-center">
              <div class="font-display font-bold text-[var(--color-accent)] opacity-30 text-4xl lg:text-6xl mb-2">
                {project.title.split(' ').map(w => w[0]).join('')}
              </div>
              <div class="font-mono text-[0.65rem] text-[var(--color-text-muted)] uppercase tracking-widest">
                Placeholder
              </div>
            </div>
          </div>

          <div class="p-5 lg:p-6">
            <!-- Tech pills -->
            <div class="flex flex-wrap gap-1.5 mb-3">
              {project.tech.map(t => (
                <span class="font-mono text-[0.65rem] text-[var(--color-text-muted)] border border-[var(--color-border)] px-2 py-0.5 rounded transition-all duration-150 hover:bg-[var(--color-accent-subtle)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]">
                  {t}
                </span>
              ))}
            </div>

            <h3 class="font-display font-semibold text-[var(--color-text-primary)] mb-1.5 transition-colors duration-200" style="font-size: clamp(1.125rem, 1.5vw, 1.5rem)">
              {project.title}
            </h3>

            {project.highlight && (
              <div class="flex items-center gap-1.5 mb-2">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="var(--color-accent)"><path d="M6 1l1.4 2.8L11 4.3l-2.5 2.4.6 3.4L6 8.5l-3.1 1.6.6-3.4L1 4.3l3.6-.5L6 1z"/></svg>
                <span class="font-mono text-[0.65rem] text-[var(--color-accent)] uppercase tracking-wide">{project.highlight}</span>
              </div>
            )}

            <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed">
              {project.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .project-card:hover {
    transform: translateY(-4px) scale(1.01);
    border-color: rgba(139,92,246,0.4);
    box-shadow: var(--shadow-accent);
  }
</style>
