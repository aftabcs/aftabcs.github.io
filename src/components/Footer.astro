---
---
<footer class="py-8 border-t border-[var(--color-border)]" style="background: #050505">
  <div class="max-w-[1280px] mx-auto px-6">
    <!-- Desktop -->
    <div class="hidden md:flex items-center justify-between">
      <a href="#" class="font-display font-bold text-[var(--color-accent)]">AF</a>
      <nav class="flex items-center gap-6">
        {['About', 'Projects', 'Skills', 'Experience', 'Contact'].map(item => (
          <a
            href={`#${item.toLowerCase()}`}
            class="font-body text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text-secondary)] transition-colors"
          >
            {item}
          </a>
        ))}
      </nav>
      <div class="font-body text-xs text-[var(--color-text-muted)]">
        &copy; 2026 Aftab Alam &nbsp;&bull;&nbsp; Built with Astro <span class="text-[var(--color-accent)]">&hearts;</span>
      </div>
    </div>

    <!-- Mobile -->
    <div class="md:hidden flex flex-col items-center gap-4 text-center">
      <a href="#" class="font-display font-bold text-[var(--color-accent)]">AF</a>
      <nav class="flex flex-wrap justify-center gap-4">
        {['About', 'Projects', 'Skills', 'Experience', 'Contact'].map(item => (
          <a
            href={`#${item.toLowerCase()}`}
            class="font-body text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text-secondary)] transition-colors"
          >
            {item}
          </a>
        ))}
      </nav>
      <div class="font-body text-xs text-[var(--color-text-muted)]">
        &copy; 2026 Aftab Alam &nbsp;&bull;&nbsp; Built with Astro <span class="text-[var(--color-accent)]">&hearts;</span>
      </div>
    </div>
  </div>
</footer>
