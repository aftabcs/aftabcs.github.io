---
---
<footer class="py-8" style="background: var(--color-footer-bg); backdrop-filter: var(--blur-sm); -webkit-backdrop-filter: var(--blur-sm); border-top: 1px solid var(--color-border)">
  <div class="max-w-[1280px] mx-auto px-6">
    <!-- Desktop -->
    <div class="hidden md:flex items-center justify-between">
      <a href="#" class="font-display font-bold" style="color: var(--color-accent)">AF</a>
      <nav class="flex items-center gap-6">
        {['About', 'Projects', 'Skills', 'Experience', 'Contact'].map(item => (
          <a
            href={`#${item.toLowerCase()}`}
            class="font-body text-sm transition-colors"
            style="color: var(--color-text-muted)"
          >
            {item}
          </a>
        ))}
      </nav>
      <div class="font-body text-xs" style="color: var(--color-text-muted)">
        &copy; 2026 Aftab Alam
      </div>
    </div>

    <!-- Mobile -->
    <div class="md:hidden flex flex-col items-center gap-4 text-center">
      <a href="#" class="font-display font-bold" style="color: var(--color-accent)">AF</a>
      <nav class="flex flex-wrap justify-center gap-4">
        {['About', 'Projects', 'Skills', 'Experience', 'Contact'].map(item => (
          <a
            href={`#${item.toLowerCase()}`}
            class="font-body text-sm transition-colors"
            style="color: var(--color-text-muted)"
          >
            {item}
          </a>
        ))}
      </nav>
      <div class="font-body text-xs" style="color: var(--color-text-muted)">
        &copy; 2026 Aftab Alam
      </div>
    </div>
  </div>
</footer>
