---
---
<section id="education" class="py-24 lg:py-32">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">

      <!-- Education -->
      <div>
        <div class="reveal mb-10">
          <div class="section-label mb-4">Education</div>
          <h2 class="font-display font-bold" style="font-size: clamp(2rem, 3.5vw, 3rem); letter-spacing: -0.02em; line-height: 1.1; color: var(--color-text-primary)">
            Academic Background
          </h2>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl p-6 reveal" style="
            background: var(--glass-base);
            backdrop-filter: var(--blur-md);
            -webkit-backdrop-filter: var(--blur-md);
            border: 1px solid var(--color-border);
            border-top-color: var(--color-border-light);
            box-shadow: var(--shadow-glass-base);
          ">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-accent-subtle)">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M10 2L2 6.5l8 4.5 8-4.5L10 2z" stroke="var(--color-accent)" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M2 6.5v6M10 11v7M18 6.5v6" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-base mb-0.5" style="color: var(--color-text-primary)">B.Tech Computer Science</h3>
                <div class="text-sm mb-1" style="color: var(--color-text-secondary)">Jahangirabad Institute of Technology, AKTU</div>
                <div class="font-mono text-[0.7rem] uppercase tracking-wide" style="color: var(--color-text-muted)">2022</div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl p-6 reveal" style="
            background: var(--glass-base);
            backdrop-filter: var(--blur-md);
            -webkit-backdrop-filter: var(--blur-md);
            border: 1px solid var(--color-border);
            border-top-color: var(--color-border-light);
            box-shadow: var(--shadow-glass-base);
          ">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-accent-subtle)">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <rect x="3" y="3" width="14" height="14" rx="2" stroke="var(--color-accent)" stroke-width="1.5"/>
                  <path d="M7 10h6M7 7h4M7 13h2" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-base mb-0.5" style="color: var(--color-text-primary)">O Level Certification</h3>
                <div class="text-sm mb-1" style="color: var(--color-text-secondary)">NIELIT — National Institute of Electronics & IT</div>
                <div class="font-mono text-[0.7rem] uppercase tracking-wide" style="color: var(--color-text-muted)">2018</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Awards -->
      <div>
        <div class="reveal mb-10">
          <div class="section-label mb-4">Awards</div>
          <h2 class="font-display font-bold" style="font-size: clamp(2rem, 3.5vw, 3rem); letter-spacing: -0.02em; line-height: 1.1; color: var(--color-text-primary)">
            Recognition
          </h2>
        </div>

        <div class="space-y-6">
          <!-- Featured award -->
          <div class="rounded-2xl p-6 reveal" style="
            background: var(--glass-base);
            backdrop-filter: var(--blur-md);
            -webkit-backdrop-filter: var(--blur-md);
            border: 1px solid rgba(139,92,246,0.35);
            border-top-color: rgba(167,139,250,0.25);
            box-shadow: var(--shadow-accent);
          ">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-accent-subtle)">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="var(--color-accent)">
                  <path d="M10 2l1.8 3.6L16 6.3l-3 2.9.7 4.1L10 11.2l-3.7 2.1.7-4.1L4 6.3l4.2-.7L10 2z"/>
                </svg>
              </div>
              <div>
                <div class="font-mono text-[0.65rem] uppercase tracking-widest mb-1" style="color: var(--color-accent-bright)">2023</div>
                <h3 class="font-display font-semibold text-base mb-1" style="color: var(--color-text-primary)">Islamic Digital Banking Provider of the Year</h3>
                <div class="text-sm" style="color: var(--color-text-secondary)">Ajman Bank Connect — as Team Lead at Codebase Technology</div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl p-6 reveal" style="
            background: var(--glass-base);
            backdrop-filter: var(--blur-md);
            -webkit-backdrop-filter: var(--blur-md);
            border: 1px solid var(--color-border);
            border-top-color: var(--color-border-light);
            box-shadow: var(--shadow-glass-base);
          ">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--color-accent-subtle)">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <circle cx="10" cy="7" r="4" stroke="var(--color-accent)" stroke-width="1.5"/>
                  <path d="M6 11v5l4-2 4 2v-5" stroke="var(--color-accent)" stroke-width="1.5" stroke-linejoin="round"/>
                </svg>
              </div>
              <div>
                <div class="font-mono text-[0.65rem] uppercase tracking-widest mb-1" style="color: var(--color-text-muted)">Nov 2023 &amp; Feb 2024</div>
                <h3 class="font-display font-semibold text-base mb-1" style="color: var(--color-text-primary)">Employee of the Month</h3>
                <div class="text-sm" style="color: var(--color-text-secondary)">Recognized twice for exceptional performance and delivery at NeoSoft Technology</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
